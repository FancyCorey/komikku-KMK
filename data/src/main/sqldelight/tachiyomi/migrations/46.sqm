-- KMK --> Phase 1: Personal recommendations taste profile tables

CREATE TABLE IF NOT EXISTS manga_taste (
    manga_id INTEGER NOT NULL PRIMARY KEY,
    source INTEGER NOT NULL,
    url TEXT NOT NULL,
    title TEXT NOT NULL,
    rating INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES mangas(_id)
    ON DELETE CASCADE
);

CREATE UNIQUE INDEX IF NOT EXISTS manga_taste_source_url_index ON manga_taste(source, url);
CREATE INDEX IF NOT EXISTS manga_taste_rating_index ON manga_taste(rating);

CREATE TABLE IF NOT EXISTS tag_taste (
    normalized_tag TEXT NOT NULL PRIMARY KEY,
    display_name TEXT NOT NULL,
    preference INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS tag_taste_preference_index ON tag_taste(preference);

CREATE TABLE IF NOT EXISTS tag_alias (
    alias TEXT NOT NULL PRIMARY KEY,
    normalized_alias TEXT NOT NULL,
    group_key TEXT NOT NULL,
    display_name TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS tag_alias_group_key_index ON tag_alias(group_key);
CREATE INDEX IF NOT EXISTS tag_alias_normalized_index ON tag_alias(normalized_alias);

CREATE TABLE IF NOT EXISTS recommendation_cache (
    cache_key TEXT NOT NULL PRIMARY KEY,
    source_id INTEGER NOT NULL,
    profile_fingerprint TEXT NOT NULL,
    query_key TEXT NOT NULL,
    result_manga_ids TEXT NOT NULL,
    result_scores TEXT,
    result_reasons TEXT,
    created_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS recommendation_cache_source_index ON recommendation_cache(source_id);
CREATE INDEX IF NOT EXISTS recommendation_cache_expires_index ON recommendation_cache(expires_at);

CREATE TABLE IF NOT EXISTS recommendation_disabled_source (
    source_id INTEGER NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL
);

