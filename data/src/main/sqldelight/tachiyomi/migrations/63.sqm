import kotlin.Boolean;
import kotlinx.serialization.json.JsonObject;

-- Official Komikku 1.14.0 reconciliation, part 1: append-only, ported against the
-- current KMK schema (KMK migrations occupy 45-62; this never renumbers or overwrites them).
--
-- Official upstream 1.14.0 shipped this as its own migrations 45 and 46. The performance-index
-- half of upstream's 45 was already present in KMK's own 45.sqm (verified byte-identical during
-- the 1.14.0 reconciliation audit), so it is intentionally NOT repeated here. This migration ports
-- only the remaining part of upstream 1.14.0 that KMK's own migration history did not already
-- cover: the extension_repos -> extension_store conversion, and the mangas.memo / chapters.memo
-- columns. (This migration is part of the completed 1.14.0 reconciliation and ships as-is; an
-- earlier draft of this comment described the ported part as "not-yet-applied," which read as if
-- this migration itself were still pending -- it is not.)

-- extension_repos -> extension_store: same conversion upstream performs, run against KMK's actual
-- extension_repos schema (verified identical to official 1.13.6's extension_repos schema, so the
-- official SELECT mapping applies unchanged).
CREATE TABLE IF NOT EXISTS extension_store(
    index_url TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    badge_label TEXT NOT NULL,
    signing_key TEXT NOT NULL,
    contact_website TEXT NOT NULL,
    contact_discord TEXT,
    is_legacy INTEGER AS Boolean NOT NULL,
    extension_list_url TEXT
);

INSERT OR IGNORE INTO extension_store(index_url, name, badge_label, signing_key, contact_website, contact_discord, is_legacy)
SELECT base_url || '/repo.json', name, coalesce(short_name, name), signing_key_fingerprint, website, NULL, 1 FROM extension_repos;

DROP TABLE IF EXISTS extension_repos;

-- mangas.memo / chapters.memo: same column, type, default, and JSON adapter semantics as official
-- 1.14.0 (BLOB AS JsonObject, default empty JSON object). Used only as vacant, forward-compatible
-- storage in this reconciliation pass; no KMK or official feature reads/writes it yet beyond the
-- default. ALTER TABLE ADD COLUMN is idempotent-safe to skip if already applied because SQLDelight
-- only replays a given .sqm file once per database, tracked by schema version -- this file is only
-- ever applied once per upgrading database, same as every other migration in this history.
ALTER TABLE mangas ADD COLUMN memo BLOB AS JsonObject NOT NULL DEFAULT (CAST('{}' AS BLOB));
ALTER TABLE chapters ADD COLUMN memo BLOB AS JsonObject NOT NULL DEFAULT (CAST('{}' AS BLOB));
