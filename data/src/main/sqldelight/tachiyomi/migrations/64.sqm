-- KMK_CLAUDE_LATEST_EXPLORATION_STRUCTURAL_COMPLETION_2026-08-08: additive-only migration for the
-- local-only For You exposure history table -- see recommendation_exposure.sq for the full schema
-- rationale. No existing table is altered, renamed, or dropped.
--
-- KMK_CLAUDE_TRACKER_SAFE_LOOKUP_2026-08-09: CREATE statements now carry IF NOT EXISTS, matching the
-- idempotency contract every other KMK migration follows and KmkMigrationTest enforces. Without it,
-- re-running this migration against a database that already has the table would fail instead of
-- being a no-op.
CREATE TABLE IF NOT EXISTS recommendation_exposure (
    source_id INTEGER NOT NULL,
    url TEXT NOT NULL,
    manga_id INTEGER,
    first_exposed_at INTEGER NOT NULL,
    last_exposed_at INTEGER NOT NULL,
    exposure_count INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (source_id, url)
);

CREATE INDEX IF NOT EXISTS recommendation_exposure_last_exposed_index
    ON recommendation_exposure(last_exposed_at);
CREATE INDEX IF NOT EXISTS recommendation_exposure_source_index
    ON recommendation_exposure(source_id);
