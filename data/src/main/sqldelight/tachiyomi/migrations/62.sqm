-- KMK --> v0.8.0: Rated Manga bulk selection + group actions. User-selected primary version per
-- confirmed cross-source link group, stored separately from manga_cross_source_link so choosing a
-- primary is independent of the link upsert/delete lifecycle. One primary per group id.
CREATE TABLE IF NOT EXISTS manga_cross_source_group_primary (
    group_id TEXT NOT NULL PRIMARY KEY,
    source INTEGER NOT NULL,
    url TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);
