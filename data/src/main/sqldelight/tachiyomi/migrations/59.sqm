-- KMK --> v0.7.40: Add retry metadata columns to recommendation_discovery_progress so that
-- transient network failures can be retried with bounded exponential backoff instead of
-- being permanently skipped. All three columns are nullable/defaulted for safe ALTER TABLE.
ALTER TABLE recommendation_discovery_progress ADD COLUMN attempt_count INTEGER NOT NULL DEFAULT 0;
ALTER TABLE recommendation_discovery_progress ADD COLUMN next_retry_at INTEGER;
ALTER TABLE recommendation_discovery_progress ADD COLUMN failure_kind TEXT;
-- KMK <--
