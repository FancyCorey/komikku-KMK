-- KMK -->
CREATE TABLE unsafe_extension_package (
    pkg_name TEXT NOT NULL PRIMARY KEY,
    extension_name TEXT,
    reason TEXT NOT NULL,
    source TEXT NOT NULL,
    removable INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

getAll:
SELECT *
FROM unsafe_extension_package
ORDER BY updated_at DESC;

getAllAsFlow:
SELECT *
FROM unsafe_extension_package
ORDER BY updated_at DESC;

getByPkg:
SELECT *
FROM unsafe_extension_package
WHERE pkg_name = :pkgName;

upsert:
INSERT INTO unsafe_extension_package(
    pkg_name, extension_name, reason, source, removable, created_at, updated_at
)
VALUES (
    :pkgName, :extensionName, :reason, :source, :removable, :now, :now
)
ON CONFLICT(pkg_name) DO UPDATE SET
    extension_name = :extensionName,
    reason = :reason,
    source = :source,
    removable = :removable,
    updated_at = :now;

deleteByPkg:
DELETE FROM unsafe_extension_package
WHERE pkg_name = :pkgName;

deleteAll:
DELETE FROM unsafe_extension_package;
-- KMK <--
